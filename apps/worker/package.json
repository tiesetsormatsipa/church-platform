{
  "name": "@church/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@church/database": "workspace:*",
    "@church/infrastructure": "workspace:*",
    "@church/shared": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@church/config": "workspace:*",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.1"
  }
}
