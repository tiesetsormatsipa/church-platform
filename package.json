{
  "name": "church-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker/compose.dev.yml logs -f",
    "setup": "pnpm install && pnpm db:generate && pnpm build:packages && pnpm db:migrate:deploy && pnpm db:seed:demo",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"./packages/*\" --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"!@church/web-e2e\" test",
    "test:integration": "pnpm --filter @church/api test:integration",
    "test:e2e": "pnpm --filter @church/web test:e2e",
    "db:generate": "pnpm --filter @church/database generate",
    "db:migrate": "pnpm --filter @church/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @church/database migrate:deploy",
    "db:reset": "pnpm --filter @church/database migrate:reset",
    "db:seed": "pnpm --filter @church/database seed",
    "db:studio": "pnpm --filter @church/database studio",
    "api:openapi": "pnpm --filter @church/api build && pnpm --filter @church/api openapi && pnpm --filter @church/api-client generate && pnpm --filter @church/api-client build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:seed:demo": "pnpm --filter @church/database seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
