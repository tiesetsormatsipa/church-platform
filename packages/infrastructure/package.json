{
  "name": "@church/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": { "types": "./dist/env.d.ts", "default": "./dist/env.js" },
    "./logger": { "types": "./dist/logger.d.ts", "default": "./dist/logger.js" },
    "./password": { "types": "./dist/password.d.ts", "default": "./dist/password.js" },
    "./tokens": { "types": "./dist/tokens.d.ts", "default": "./dist/tokens.js" },
    "./redis": { "types": "./dist/redis.d.ts", "default": "./dist/redis.js" },
    "./queue": { "types": "./dist/queue.d.ts", "default": "./dist/queue.js" },
    "./storage": { "types": "./dist/storage/index.d.ts", "default": "./dist/storage/index.js" },
    "./mail": { "types": "./dist/mail/index.d.ts", "default": "./dist/mail/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@church/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@church/config": "workspace:*",
    "vitest": "^5.0.1"
  }
}
