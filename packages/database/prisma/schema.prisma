// Church Platform domain model.
//
// Conventions
// - Models are PascalCase and map to snake_case tables; fields map to snake_case columns.
// - Primary keys are UUIDv7 (time-ordered). Every timestamp is timestamptz(3).
// - Constraints Prisma cannot express (CHECK constraints, the generated search vector,
//   the search-vector trigger, NULLS NOT DISTINCT) live in migration SQL. See docs/ARCHITECTURE.md §4 and CLAUDE.md
//   before editing migrations.
// - Enum values are mirrored in packages/shared/src/enums.ts (a test guards drift).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ContentType {
  POST
  ANNOUNCEMENT
  NEWS
  EVENT
  SERMON
  BAPTISM

  @@map("content_type")
}

enum ContentScope {
  GLOBAL
  BRANCH

  @@map("content_scope")
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum BodyFormat {
  MARKDOWN

  @@map("body_format")
}

enum EventStatus {
  SCHEDULED
  POSTPONED
  CANCELLED

  @@map("event_status")
}

enum EventCategory {
  SERVICE
  CONFERENCE
  BAPTISM
  YOUTH
  PRAYER
  OUTREACH
  FELLOWSHIP
  OTHER

  @@map("event_category")
}

enum BranchType {
  MAIN
  SUB
  SATELLITE
  ONLINE

  @@map("branch_type")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("branch_status")
}

enum ScheduleKind {
  SERVICE
  PRAYER
  FASTING
  BIBLE_STUDY
  YOUTH
  OTHER

  @@map("schedule_kind")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT

  @@map("membership_status")
}

enum RoleScope {
  ORGANIZATION
  BRANCH

  @@map("role_scope")
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT

  @@map("media_kind")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED

  @@map("media_status")
}

enum MediaVisibility {
  PUBLIC
  PRIVATE

  @@map("media_visibility")
}

enum MediaPurpose {
  COVER
  AVATAR
  GALLERY
  SERMON_AUDIO
  SERMON_VIDEO
  DOCUMENT

  @@map("media_purpose")
}

enum NotificationCategory {
  ANNOUNCEMENTS
  UPDATES
  EVENTS
  NEWS
  SERMONS
  BAPTISM
  MEMBERSHIP
  ACCOUNT

  @@map("notification_category")
}

enum BaptismRequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CLOSED

  @@map("baptism_request_status")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED

  @@map("email_delivery_status")
}

enum MigrationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("migration_run_status")
}

// ---------------------------------------------------------------------------
// Organisation and branches
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(160)
  shortName   String?  @map("short_name") @db.VarChar(60)
  tagline     String?  @db.VarChar(200)
  description String?
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(40)
  websiteUrl  String?  @map("website_url") @db.VarChar(2048)
  timezone    String   @default("Africa/Johannesburg") @db.VarChar(64)
  locale      String   @default("en-ZA") @db.VarChar(16)
  logoMediaId String?  @map("logo_media_id") @db.Uuid
  /// Typed operational settings, validated by `OrganizationSettings` in @church/shared.
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logoMedia       MediaAsset?      @relation("OrganizationLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  branches        Branch[]
  contentItems    ContentItem[]
  roles           Role[]
  roleAssignments RoleAssignment[]
  mediaAssets     MediaAsset[]     @relation("OrganizationMedia")
  speakers        Speaker[]
  sermonSeries    SermonSeries[]
  tags            Tag[]
  baptismRequests BaptismRequest[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  slug           String       @db.VarChar(80)
  /// Canonical presentation name ("Johannesburg"). Presentation fixes are made here.
  name           String       @db.VarChar(120)
  /// Exact label the legacy system used ("Johanessburg", "PTA"); never shown by default.
  legacyLabel    String?      @map("legacy_label") @db.VarChar(120)
  type           BranchType   @default(MAIN)
  status         BranchStatus @default(ACTIVE)
  parentBranchId String?      @map("parent_branch_id") @db.Uuid
  description    String?
  addressLine1   String?      @map("address_line1") @db.VarChar(200)
  addressLine2   String?      @map("address_line2") @db.VarChar(200)
  city           String?      @db.VarChar(120)
  province       String?      @db.VarChar(120)
  postalCode     String?      @map("postal_code") @db.VarChar(20)
  countryCode    String       @default("ZA") @map("country_code") @db.Char(2)
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  mapsUrl        String?      @map("maps_url") @db.VarChar(2048)
  phone          String?      @db.VarChar(40)
  email          String?      @db.VarChar(254)
  coverMediaId   String?      @map("cover_media_id") @db.Uuid
  sortOrder      Int          @default(0) @map("sort_order")
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentBranch    Branch?               @relation("BranchHierarchy", fields: [parentBranchId], references: [id], onDelete: SetNull)
  subBranches     Branch[]              @relation("BranchHierarchy")
  coverMedia      MediaAsset?           @relation("BranchCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("BranchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("BranchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  schedules       BranchSchedule[]
  leaders         BranchLeader[]
  galleryItems    BranchGalleryItem[]
  serviceRecords  BranchServiceRecord[]
  baptismRecords  BranchBaptismRecord[]
  memberships     BranchMembership[]
  roleAssignments RoleAssignment[]
  contentItems    ContentItem[]
  homeProfiles    Profile[]
  speakers        Speaker[]
  baptismRequests BaptismRequest[]
  auditLogs       AuditLog[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
  @@index([parentBranchId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "branches_name_trgm_idx")
  @@map("branches")
}

/// Recurring or dated activities of a branch: services, prayer meetings, fasting, studies.
/// Temporary changes use an effective date range; `replacesRegular` hides the regular
/// entries of the same kind while the temporary entry is in effect.
model BranchSchedule {
  id              String       @id @default(uuid(7)) @db.Uuid
  branchId        String       @map("branch_id") @db.Uuid
  kind            ScheduleKind
  title           String?      @db.VarChar(120)
  /// 0 = Sunday … 6 = Saturday. Null for patterns described in `recurrenceText`.
  dayOfWeek       Int?         @map("day_of_week") @db.SmallInt
  /// Wall-clock time in the branch's time zone, "HH:MM".
  startTime       String?      @map("start_time") @db.VarChar(5)
  endTime         String?      @map("end_time") @db.VarChar(5)
  recurrenceText  String?      @map("recurrence_text") @db.VarChar(200)
  notes           String?      @db.VarChar(500)
  effectiveFrom   DateTime?    @map("effective_from") @db.Date
  effectiveUntil  DateTime?    @map("effective_until") @db.Date
  replacesRegular Boolean      @default(false) @map("replaces_regular")
  isActive        Boolean      @default(true) @map("is_active")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, kind, isActive])
  @@map("branch_schedules")
}

model BranchLeader {
  id           String   @id @default(uuid(7)) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String   @db.VarChar(120)
  /// Pastoral title, e.g. "Overseer", "Minister", "Deacon".
  title        String   @db.VarChar(120)
  userId       String?  @map("user_id") @db.Uuid
  photoMediaId String?  @map("photo_media_id") @db.Uuid
  bio          String?  @db.VarChar(1000)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User?       @relation("BranchLeaderUser", fields: [userId], references: [id], onDelete: SetNull)
  photoMedia MediaAsset? @relation("BranchLeaderPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@index([branchId, isActive, sortOrder])
  @@map("branch_leaders")
}

model BranchGalleryItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  caption   String?  @db.VarChar(300)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([branchId, mediaId])
  @@map("branch_gallery_items")
}

/// Per-service statistics kept by branch administrators (attendance, offering, baptisms).
model BranchServiceRecord {
  id              String    @id @default(uuid(7)) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  serviceDate     DateTime  @map("service_date") @db.Date
  serviceLabel    String?   @map("service_label") @db.VarChar(120)
  attendance      Int?
  durationMinutes Int?      @map("duration_minutes")
  preacherName    String?   @map("preacher_name") @db.VarChar(120)
  offeringAmount  Decimal?  @map("offering_amount") @db.Decimal(12, 2)
  currency        String    @default("ZAR") @db.Char(3)
  baptismsCount   Int?      @map("baptisms_count")
  notes           String?   @db.VarChar(2000)
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  branch    Branch                        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?                         @relation("ServiceRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?                         @relation("ServiceRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions BranchServiceRecordRevision[]

  @@index([branchId, serviceDate(sort: Desc)])
  @@map("branch_service_records")
}

/// One baptism entry for a branch: how many people were baptised, on which day.
///
/// The church holds no baptism days and takes no applications: after a service they ask who
/// would like to be baptised, and afterwards someone records the number here. A branch's
/// total is the sum of its rows; a country's total is the sum of its branches; the global
/// total is the sum of the countries. Totals also roll up the branch tree, so a main branch
/// can be shown with or without the sub-branches under it.
model BranchBaptismRecord {
  id           String    @id @default(uuid(7)) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  /// The day the baptisms took place, usually the day of a service.
  occurredOn   DateTime  @map("occurred_on") @db.Date
  /// How many people were baptised that day (a CHECK constraint keeps it above zero).
  count        Int
  note         String?   @db.VarChar(500)
  recordedById String?   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("BaptismRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  // Branch totals and the branch's own list, newest first.
  @@index([branchId, occurredOn(sort: Desc)], map: "branch_baptism_records_branch_idx", where: raw("deleted_at IS NULL"))
  // Year totals across every branch.
  @@index([occurredOn], map: "branch_baptism_records_period_idx", where: raw("deleted_at IS NULL"))
  @@map("branch_baptism_records")
}

model BranchServiceRecordRevision {
  id          String   @id @default(uuid(7)) @db.Uuid
  recordId    String   @map("record_id") @db.Uuid
  changedById String?  @map("changed_by_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  /// [{ field, from, to }]
  changes     Json
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  record    BranchServiceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  changedBy User?               @relation("ServiceRecordRevisionBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([recordId, changedAt(sort: Desc)])
  @@map("branch_service_record_revisions")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case (CHECK constraint).
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// argon2id; legacy formats are re-hashed on first successful login (ADR-009).
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  status            UserStatus @default(ACTIVE)
  statusReason      String?    @map("status_reason") @db.VarChar(500)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile                 Profile?
  identities              AuthIdentity[]
  sessions                Session[]
  authTokens              AuthToken[]
  roleAssignments         RoleAssignment[]              @relation("RoleAssignmentUser")
  grantedRoleAssignments  RoleAssignment[]              @relation("RoleAssignmentGrantedBy")
  memberships             BranchMembership[]            @relation("MembershipUser")
  decidedMemberships      BranchMembership[]            @relation("MembershipDecidedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  authoredContent         ContentItem[]                 @relation("ContentAuthor")
  createdContent          ContentItem[]                 @relation("ContentCreatedBy")
  updatedContent          ContentItem[]                 @relation("ContentUpdatedBy")
  publishedContent        ContentItem[]                 @relation("ContentPublishedBy")
  uploadedMedia           MediaAsset[]                  @relation("MediaUploadedBy")
  createdBranches         Branch[]                      @relation("BranchCreatedBy")
  updatedBranches         Branch[]                      @relation("BranchUpdatedBy")
  branchLeaderships       BranchLeader[]                @relation("BranchLeaderUser")
  createdServiceRecords   BranchServiceRecord[]         @relation("ServiceRecordCreatedBy")
  updatedServiceRecords   BranchServiceRecord[]         @relation("ServiceRecordUpdatedBy")
  serviceRecordRevisions  BranchServiceRecordRevision[] @relation("ServiceRecordRevisionBy")
  baptismRecords          BranchBaptismRecord[]         @relation("BaptismRecordedBy")
  speakerProfiles         Speaker[]                     @relation("SpeakerUser")
  baptismRequests         BaptismRequest[]              @relation("BaptismRequestUser")
  assignedBaptismRequests BaptismRequest[]              @relation("BaptismRequestAssignee")
  emailDeliveries         EmailDelivery[]
  auditLogs               AuditLog[]

  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@map("users")
}

model Profile {
  userId           String    @id @map("user_id") @db.Uuid
  firstName        String    @map("first_name") @db.VarChar(80)
  lastName         String    @map("last_name") @db.VarChar(80)
  displayName      String?   @map("display_name") @db.VarChar(120)
  avatarMediaId    String?   @map("avatar_media_id") @db.Uuid
  phone            String?   @db.VarChar(40)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  bio              String?   @db.VarChar(1000)
  homeBranchId     String?   @map("home_branch_id") @db.Uuid
  baptismDate      DateTime? @map("baptism_date") @db.Date
  baptismPlace     String?   @map("baptism_place") @db.VarChar(200)
  privacyConsentAt DateTime? @map("privacy_consent_at") @db.Timestamptz(3)
  termsAcceptedAt  DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia MediaAsset? @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  homeBranch  Branch?     @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)

  @@index([homeBranchId])
  @@index([firstName(ops: raw("gin_trgm_ops")), lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "profiles_name_trgm_idx")
  @@map("profiles")
}

/// External identity providers (OAuth). Ready for Google sign-in; imported from legacy googleId.
model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  email          String?      @db.VarChar(254)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// Server-side browser session. Only the SHA-256 of the cookie token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  rememberMe        Boolean   @default(false) @map("remember_me")
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Single-use tokens sent by e-mail (verification, password reset). Only hashes are stored.
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  sentTo     String?          @map("sent_to") @db.VarChar(254)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model Role {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Stable machine key, e.g. "branch_admin".
  key            String    @db.VarChar(64)
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(500)
  /// Level at which the role is granted: church-wide or per branch.
  scope          RoleScope
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  RoleAssignment[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  /// A key of PERMISSIONS in @church/shared.
  permission String @db.VarChar(64)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Grants a role church-wide (branchId = null) or for one branch.
model RoleAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  grantedById    String?   @map("granted_by_id") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)

  user         User         @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  // Migration SQL creates this index with NULLS NOT DISTINCT so that a church-wide grant
  // (branch_id NULL) is also unique per user and role.
  @@unique([userId, roleId, branchId], map: "role_assignments_user_role_branch_key")
  @@index([branchId])
  @@map("role_assignments")
}

/// A person's membership of a branch, reviewed by that branch's administrators.
model BranchMembership {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  status       MembershipStatus @default(PENDING)
  isPrimary    Boolean          @default(true) @map("is_primary")
  message      String?          @db.VarChar(1000)
  decisionNote String?          @map("decision_note") @db.VarChar(1000)
  requestedAt  DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedById  String?          @map("decided_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("MembershipDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, branchId])
  @@unique([userId], map: "branch_memberships_one_primary_idx", where: raw("is_primary AND (status = 'PENDING' OR status = 'ACTIVE')"))
  @@index([branchId, status, requestedAt])
  @@map("branch_memberships")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// Every publishable item (post, announcement, news, event, sermon, baptism story).
/// Type-specific fields live in the 1–1 detail tables. `scope` decides visibility:
/// GLOBAL = church-wide (branchId must be null), BRANCH = one branch (branchId required).
model ContentItem {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  type           ContentType
  scope          ContentScope
  branchId       String?                  @map("branch_id") @db.Uuid
  slug           String                   @db.VarChar(100)
  title          String                   @db.VarChar(200)
  summary        String?                  @db.VarChar(500)
  body           String?
  bodyFormat     BodyFormat               @default(MARKDOWN) @map("body_format")
  status         ContentStatus            @default(DRAFT)
  /// Visible when status = PUBLISHED and publishedAt <= now(); a future value schedules it.
  publishedAt    DateTime?                @map("published_at") @db.Timestamptz(3)
  isPinned       Boolean                  @default(false) @map("is_pinned")
  pinnedUntil    DateTime?                @map("pinned_until") @db.Timestamptz(3)
  isFeatured     Boolean                  @default(false) @map("is_featured")
  coverMediaId   String?                  @map("cover_media_id") @db.Uuid
  coverAlt       String?                  @map("cover_alt") @db.VarChar(300)
  authorId       String?                  @map("author_id") @db.Uuid
  /// Display name override (e.g. imported content whose author has no account).
  authorName     String?                  @map("author_name") @db.VarChar(120)
  seoTitle       String?                  @map("seo_title") @db.VarChar(200)
  seoDescription String?                  @map("seo_description") @db.VarChar(300)
  createdById    String?                  @map("created_by_id") @db.Uuid
  updatedById    String?                  @map("updated_by_id") @db.Uuid
  publishedById  String?                  @map("published_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// Full-text vector (title A, summary B, body C), maintained by a trigger in migration SQL.
  searchVector   Unsupported("tsvector")? @map("search_vector")

  organization             Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                   Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coverMedia               MediaAsset?      @relation("ContentCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  author                   User?            @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdBy                User?            @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?            @relation("ContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedBy              User?            @relation("ContentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  event                    EventDetail?
  sermon                   SermonDetail?
  baptism                  BaptismDetail?
  tags                     ContentTag[]
  media                    ContentMedia[]
  baptismRequestsScheduled BaptismRequest[]

  @@unique([organizationId, slug])
  @@index([searchVector], type: Gin, map: "content_items_search_idx")
  // Public feeds: published, not deleted, newest first (keyset pagination on published_at, id).
  @@index([organizationId, publishedAt(sort: Desc), id(sort: Desc)], map: "content_items_feed_idx", where: raw("status = 'PUBLISHED' AND deleted_at IS NULL"))
  @@index([branchId, publishedAt(sort: Desc), id(sort: Desc)], map: "content_items_branch_feed_idx", where: raw("status = 'PUBLISHED' AND deleted_at IS NULL"))
  @@index([organizationId, type, publishedAt(sort: Desc), id(sort: Desc)], map: "content_items_type_feed_idx", where: raw("status = 'PUBLISHED' AND deleted_at IS NULL"))
  // Admin lists: every status, most recently edited first.
  @@index([organizationId, type, status, updatedAt(sort: Desc)])
  @@index([authorId])
  @@map("content_items")
}

model EventDetail {
  contentId       String        @id @map("content_id") @db.Uuid
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?     @map("ends_at") @db.Timestamptz(3)
  allDay          Boolean       @default(false) @map("all_day")
  timezone        String        @default("Africa/Johannesburg") @db.VarChar(64)
  category        EventCategory @default(OTHER)
  eventStatus     EventStatus   @default(SCHEDULED) @map("event_status")
  statusNote      String?       @map("status_note") @db.VarChar(300)
  venueName       String?       @map("venue_name") @db.VarChar(200)
  venueAddress    String?       @map("venue_address") @db.VarChar(300)
  mapsUrl         String?       @map("maps_url") @db.VarChar(2048)
  onlineUrl       String?       @map("online_url") @db.VarChar(2048)
  registrationUrl String?       @map("registration_url") @db.VarChar(2048)

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([startsAt])
  @@map("event_details")
}

model SermonDetail {
  contentId        String   @id @map("content_id") @db.Uuid
  preachedOn       DateTime @map("preached_on") @db.Date
  speakerId        String?  @map("speaker_id") @db.Uuid
  /// Denormalised speaker name for display and for speakers without a profile.
  speakerName      String?  @map("speaker_name") @db.VarChar(120)
  seriesId         String?  @map("series_id") @db.Uuid
  scripture        String?  @db.VarChar(300)
  audioMediaId     String?  @map("audio_media_id") @db.Uuid
  videoMediaId     String?  @map("video_media_id") @db.Uuid
  externalVideoUrl String?  @map("external_video_url") @db.VarChar(2048)
  durationSeconds  Int?     @map("duration_seconds")
  language         String   @default("en") @db.VarChar(16)
  transcript       String?

  content    ContentItem   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  speaker    Speaker?      @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  series     SermonSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  audioMedia MediaAsset?   @relation("SermonAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  videoMedia MediaAsset?   @relation("SermonVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)

  @@index([speakerId, preachedOn(sort: Desc)])
  @@index([seriesId, preachedOn(sort: Desc)])
  @@index([preachedOn(sort: Desc)])
  @@map("sermon_details")
}

model BaptismDetail {
  contentId       String    @id @map("content_id") @db.Uuid
  baptismDate     DateTime? @map("baptism_date") @db.Date
  candidatesCount Int?      @map("candidates_count")
  officiantName   String?   @map("officiant_name") @db.VarChar(120)
  location        String?   @db.VarChar(200)

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("baptism_details")
}

model Speaker {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @db.VarChar(80)
  name           String   @db.VarChar(120)
  title          String?  @db.VarChar(120)
  bio            String?  @db.VarChar(2000)
  photoMediaId   String?  @map("photo_media_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photoMedia   MediaAsset?    @relation("SpeakerPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?          @relation("SpeakerUser", fields: [userId], references: [id], onDelete: SetNull)
  sermons      SermonDetail[]

  @@unique([organizationId, slug])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "speakers_name_trgm_idx")
  @@map("speakers")
}

model SermonSeries {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @db.VarChar(80)
  title          String   @db.VarChar(200)
  description    String?  @db.VarChar(2000)
  coverMediaId   String?  @map("cover_media_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coverMedia   MediaAsset?    @relation("SeriesCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  sermons      SermonDetail[]

  @@unique([organizationId, slug])
  @@map("sermon_series")
}

model Tag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @db.VarChar(80)
  name           String   @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contents     ContentTag[]

  @@unique([organizationId, slug])
  @@map("tags")
}

model ContentTag {
  contentId String @map("content_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

/// Media attached to a content item (gallery images, downloadable documents).
model ContentMedia {
  contentId String  @map("content_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  caption   String? @db.VarChar(300)

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaId])
  @@index([mediaId])
  @@map("content_media")
}

/// Someone asking to be baptised. Followed up by the branch's administrators.
model BaptismRequest {
  id                 String               @id @default(uuid(7)) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  branchId           String               @map("branch_id") @db.Uuid
  userId             String?              @map("user_id") @db.Uuid
  fullName           String               @map("full_name") @db.VarChar(160)
  email              String               @db.VarChar(254)
  phone              String?              @db.VarChar(40)
  preferredDate      DateTime?            @map("preferred_date") @db.Date
  message            String?              @db.VarChar(2000)
  status             BaptismRequestStatus @default(NEW)
  assignedToId       String?              @map("assigned_to_id") @db.Uuid
  scheduledContentId String?              @map("scheduled_content_id") @db.Uuid
  internalNotes      String?              @map("internal_notes") @db.VarChar(4000)
  consentAt          DateTime             @map("consent_at") @db.Timestamptz(3)
  handledAt          DateTime?            @map("handled_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user             User?        @relation("BaptismRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo       User?        @relation("BaptismRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  scheduledContent ContentItem? @relation(fields: [scheduledContentId], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt(sort: Desc)])
  @@map("baptism_requests")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  uploadedById     String?         @map("uploaded_by_id") @db.Uuid
  kind             MediaKind
  purpose          MediaPurpose
  status           MediaStatus     @default(PENDING_UPLOAD)
  visibility       MediaVisibility
  storageKey       String          @unique @map("storage_key") @db.VarChar(512)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(127)
  sizeBytes        BigInt          @map("size_bytes")
  checksumSha256   String?         @map("checksum_sha256") @db.Char(64)
  width            Int?
  height           Int?
  durationSeconds  Int?            @map("duration_seconds")
  altText          String?         @map("alt_text") @db.VarChar(300)
  /// "#rrggbb", used as a placeholder while images load.
  dominantColor    String?         @map("dominant_color") @db.Char(7)
  metadata         Json?
  processingError  String?         @map("processing_error") @db.VarChar(1000)
  processedAt      DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization      Organization        @relation("OrganizationMedia", fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy        User?               @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants          MediaVariant[]
  organizationLogos Organization[]      @relation("OrganizationLogo")
  branchCovers      Branch[]            @relation("BranchCover")
  branchLeaders     BranchLeader[]      @relation("BranchLeaderPhoto")
  galleryItems      BranchGalleryItem[]
  profileAvatars    Profile[]           @relation("ProfileAvatar")
  contentCovers     ContentItem[]       @relation("ContentCover")
  contentMedia      ContentMedia[]
  sermonAudio       SermonDetail[]      @relation("SermonAudio")
  sermonVideo       SermonDetail[]      @relation("SermonVideo")
  speakerPhotos     Speaker[]           @relation("SpeakerPhoto")
  seriesCovers      SermonSeries[]      @relation("SeriesCover")

  @@index([organizationId, kind, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@index([status, createdAt], map: "media_assets_pending_idx", where: raw("status = 'PENDING_UPLOAD' OR status = 'UPLOADED' OR status = 'PROCESSING'"))
  @@map("media_assets")
}

/// A derived rendition: resized image, poster frame, audio preview, HLS rendition.
model MediaVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  /// e.g. "w320", "w640", "w1280", "poster", "hls_720p"
  name       String   @db.VarChar(32)
  storageKey String   @unique @map("storage_key") @db.VarChar(512)
  mimeType   String   @map("mime_type") @db.VarChar(127)
  width      Int?
  height     Int?
  sizeBytes  BigInt?  @map("size_bytes")
  bitrate    Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, name])
  @@map("media_variants")
}

// ---------------------------------------------------------------------------
// Notifications and e-mail
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  title     String               @db.VarChar(200)
  body      String?              @db.VarChar(500)
  /// App-relative link, e.g. "/events/annual-convention".
  url       String?              @db.VarChar(2048)
  data      Json?
  /// Makes fan-out retries idempotent, e.g. "content-published:<id>".
  dedupeKey String?              @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@map("notifications")
}

model NotificationPreference {
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  inApp    Boolean              @default(true) @map("in_app")
  email    Boolean              @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

model EmailDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  /// Background job that produced this delivery ("<queue>:<jobId>"). Unique, so a retry
  /// after a crash finds the existing row instead of sending the message twice.
  jobKey            String?             @unique @map("job_key") @db.VarChar(128)
  userId            String?             @map("user_id") @db.Uuid
  toEmail           String              @map("to_email") @db.VarChar(254)
  template          String              @db.VarChar(64)
  subject           String              @db.VarChar(300)
  status            EmailDeliveryStatus @default(QUEUED)
  provider          String?             @db.VarChar(32)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error") @db.VarChar(1000)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("email_deliveries")
}

// ---------------------------------------------------------------------------
// Audit and migration bookkeeping
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. "content.publish", "role.assign", "auth.login_failed".
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  branchId       String?  @map("branch_id") @db.Uuid
  summary        String?  @db.VarChar(500)
  /// Redacted before/after values of changed fields.
  changes        Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Maps a legacy record to the row it was imported as (idempotent re-runs).
model LegacyIdMap {
  source     String   @db.VarChar(40)
  entityType String   @map("entity_type") @db.VarChar(40)
  legacyId   String   @map("legacy_id") @db.VarChar(128)
  newId      String   @map("new_id") @db.Uuid
  checksum   String?  @db.Char(64)
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([source, entityType, legacyId])
  @@index([entityType, newId])
  @@map("legacy_id_map")
}

model MigrationRun {
  id         String             @id @default(uuid(7)) @db.Uuid
  source     String             @db.VarChar(40)
  command    String             @db.VarChar(40)
  status     MigrationRunStatus @default(RUNNING)
  dryRun     Boolean            @default(false) @map("dry_run")
  bundleHash String?            @map("bundle_hash") @db.Char(64)
  stats      Json               @default("{}")
  error      String?
  startedAt  DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?          @map("finished_at") @db.Timestamptz(3)

  @@index([startedAt(sort: Desc)])
  @@map("migration_runs")
}
