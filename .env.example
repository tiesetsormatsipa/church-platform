# =============================================================================
# Church Platform — local development environment
# Copy to .env (git-ignored). Values match infra/docker/compose.dev.yml.
# Production values are documented in docs/DEPLOYMENT.md.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# --- Web app ------------------------------------------------------------------
# Public origin of the site (used for links in e-mails and CSRF origin checks).
APP_ORIGIN=http://localhost:3000
# Where the web server reaches the API (server-side rendering and dev proxy).
API_INTERNAL_URL=http://localhost:4000
# Shared secret for the worker → web cache revalidation webhook.
REVALIDATE_SECRET=dev-revalidate-secret-change-me-please-32chars
# Shared by web and API: lets server-side rendering pass the visitor's IP to the API
# (x-client-ip) so rate limits apply per visitor. Use a long random value in production.
INTERNAL_API_TOKEN=dev-internal-api-token-change-me-please-32

# --- API ----------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# true behind Nginx (production), so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Secure cookies need HTTPS; false for http://localhost.
COOKIE_SECURE=false
API_DOCS_ENABLED=true
ORGANIZATION_SLUG=first-church

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://church:church@localhost:5432/church
SHADOW_DATABASE_URL=postgresql://church:church@localhost:5432/church_shadow
TEST_DATABASE_URL=postgresql://church:church@localhost:5432/church_test
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; RustFS locally) ----------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# `s3` talks to a real bucket; `memory` keeps objects in the process, which lets the site run
# with no object store at all (useful on a machine without one). Refused in production.
STORAGE_DRIVER=s3
S3_BUCKET=church-media
S3_ACCESS_KEY_ID=church-dev
S3_SECRET_ACCESS_KEY=church-dev-secret
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/church-media
STORAGE_ENSURE_BUCKET=true

# --- E-mail (Mailpit locally: UI at http://localhost:8025) ---------------------
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="First Church <no-reply@example.org>"

# --- Seed (optional first super administrator) -------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Worker -------------------------------------------------------------------
# Where the worker reaches the web server for cache revalidation.
WEB_INTERNAL_URL=http://localhost:3000
# Jobs processed at once per queue.
WORKER_CONCURRENCY=5

# --- Google sign-in (optional) ---------------------------------------------------------
# From a "Web application" OAuth client in the Google Cloud console. Both must be set for
# the button to appear; with neither, the endpoints answer 404 and nothing mentions Google.
# The console's "Authorised redirect URIs" must contain, exactly:
#   <APP_ORIGIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
